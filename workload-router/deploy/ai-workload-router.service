[Unit]
Description=AI workload router
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ai-workload-router
EnvironmentFile=-/etc/ai-workload-router/router.env
ExecStart=/usr/bin/python3 /opt/ai-workload-router/router_server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-workload-router

[Install]
WantedBy=multi-user.target
