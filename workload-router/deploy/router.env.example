# Copy to /etc/ai-workload-router/router.env and keep permissions restrictive.
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8080
ROUTER_STATE_DB=/var/lib/ai-workload-router/router-state.sqlite3
# Optional: read ordered, credential-free groups from llm-provider-manager.
# ROUTER_PROVIDER_DB=/path/to/llm_providers.db
# ROUTER_PROVIDER_GROUPS=chat-fast,coding-fast
# ROUTER_FREE_ONLY=1
# Provider-specific BASE_URL and API_KEY variables belong here, never in git.
