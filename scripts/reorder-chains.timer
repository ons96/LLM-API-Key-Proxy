[Unit]
Description=LLM-API-Key-Proxy: trigger dynamic fallback chain reorder every 30 min
Requires=reorder-chains.service

[Timer]
# Fires at :00 and :30. This does not offset past the hour; if it has to avoid
# colliding with cron, use OnCalendar=*:05/30 (:05 and :35) instead.
OnCalendar=*:0/30
Persistent=true

[Install]
WantedBy=timers.target
